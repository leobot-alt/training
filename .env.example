# Valores públicos do projeto Supabase; configure-os também como Variables no GitHub Actions.
# Nunca coloque SUPABASE_SERVICE_ROLE_KEY nem outra chave secreta no frontend.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE_PUBLICA
# Alternativa para projetos que ainda usam a chave pública legada:
# VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA
